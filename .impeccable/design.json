      "html": "<div class=\"ds-share\" role=\"group\" aria-label=\"Share this page\"><span>Share</span><button type=\"button\" aria-label=\"Share on Facebook\" title=\"Share on Facebook\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z\"/></svg></button><button type=\"button\" aria-label=\"Copy link\" title=\"Copy link\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 17H7a5 5 0 0 1 0-10h2m6 0h2a5 5 0 0 1 0 10h-2M8 12h8\"/></svg></button></div>",
      "css": ".ds-share{display:flex;align-items:center;justify-content:flex-end;gap:8px;color:var(--forest,#244d3c);font:560 13px/1.6 var(--font-public-sans,Arial),sans-serif}.ds-share>span{margin-right:5px}.ds-share button{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;padding:0;flex-shrink:0;border:0;border-radius:6px;background:var(--rail,#eef1e8);color:var(--ink,#24382d);cursor:pointer}.ds-share button:hover{background:var(--sage-strong,#ceddc0);color:var(--forest-hover,#173b2b)}.ds-share button:focus-visible{outline:2px solid var(--forest,#244d3c);outline-offset:4px}"
