  "narrative": {
    "northStar": "Community-library study desk",
    "overview": "Community-library study materials become a calm, useful place to practise. Warm paper, forest-green actions, sage navigation, and aligned subject rows give the interface an approachable, orderly character.\n\nThe system supports independent learning without borrowed employer authority or fictional activity. It uses restrained surfaces and explicit answer feedback at the appropriate stage: after submission or expiry for practice and mocks, and after checking for untimed instructional practice. Decorative staging never delays the next answer.",
    "keyCharacteristics": [
      "Useful subject rows and persistent desktop study navigation.",
      "One self-hosted type family with clear hierarchy.",
      "Tonal surfaces, fine dividers, and explicit answer states."
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "Use Public Sans across headings, reading copy, controls, and numbers; use tabular numerals for timers and scores.",
        "section": "typography"
      },
      {
        "name": "The Flat Study Surface Rule",
        "body": "Separate content through space, fine dividers, and paper or sage fills. Do not add elevation to ordinary rows or answer controls.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use native links, buttons, radio inputs, details, and progress elements.",
      "Do keep practice actions close to their instructions and preserve visible keyboard focus.",
      "Do pair answer-state color with meaningful text or accessible icons.",
      "Do retain honest empty states and numbers derived from recorded work.",
      "Do distinguish chart series beyond color, label their units, and provide accessible exact values."
    ],
    "donts": [
      "Don't add gradient text, purple glow, glassmorphism, decorative blobs, emoji icons, or generic stock-photo heroes.",
      "Don't introduce all-caps eyebrows, fictional social proof, or employer affiliation.",
      "Don't replace subject rows with a wall of interchangeable cards.",
      "Don't animate question entrances or delay feedback once it is available."
    ]
  }
}
